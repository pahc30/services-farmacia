{
  "properties": [
    {
      "name": "spring.webflux.cors.allowed-origins",
      "type": "java.util.List",
      "description": "Origenes permitidos para WebFlux CORS",
      "defaultValue": ["http://localhost:4200"]
    },
    {
      "name": "spring.webflux.cors.allowed-methods",
      "type": "java.util.List",
      "description": "Metodos HTTP permitidos para WebFlux CORS",
      "defaultValue": ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
    },
    {
      "name": "spring.webflux.cors.allowed-headers",
      "type": "java.util.List",
      "description": "Headers permitidos para WebFlux CORS",
      "defaultValue": ["*"]
    },
    {
      "name": "spring.webflux.cors.exposed-headers",
      "type": "java.util.List",
      "description": "Headers expuestos para WebFlux CORS",
      "defaultValue": ["*"]
    },
    {
      "name": "spring.webflux.cors.allow-credentials",
      "type": "java.lang.Boolean",
      "description": "Permitir credenciales en WebFlux CORS",
      "defaultValue": true
    },
    {
      "name": "auth.service.url",
      "type": "java.lang.String",
      "description": "URL del servicio de autenticacion",
      "defaultValue": "http://localhost:8081"
    },
    {
      "name": "springdoc.swagger-ui.path",
      "type": "java.lang.String",
      "description": "Ruta de Swagger UI",
      "defaultValue": "/swagger-ui.html"
    },
    {
      "name": "springdoc.swagger-ui.enabled",
      "type": "java.lang.Boolean",
      "description": "Habilitar Swagger UI",
      "defaultValue": true
    }
  ]
}